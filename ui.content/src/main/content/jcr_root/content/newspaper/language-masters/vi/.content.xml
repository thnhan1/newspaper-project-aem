<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:language="vi"
        cq:template="/conf/newspaper/settings/wcm/templates/page-content"
        jcr:mixinTypes="[cq:Blueprint]"
        jcr:primaryType="cq:PageContent"
        jcr:title="Tiếng Việt"
        pageTitle="Báo Điện Tử"
        sling:resourceType="newspaper/components/page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="newspaper/components/container"
            layout="responsiveGrid">
            <container
                jcr:primaryType="nt:unstructured"
                sling:resourceType="newspaper/components/container">
                <title
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="newspaper/components/title"/>
            </container>
        </root>
    </jcr:content>
</jcr:root>
